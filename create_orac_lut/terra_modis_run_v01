#!/bin/bash
source initpath.bash
module load intel-compilers/2022
# monochromatic calculation
# liquid-water section
export CREATE_ORAC_CLOUD_LUT_DRIVER="input_files/driver/terra_modis_cloud.driver"
echo "making ..." $CREATE_ORAC_LUT_DRIVER
idl -e "create_orac_cloud_lut_wrapper,srf_quad=1,mmfile='liquid-water_old.mm',lutfile='liquid-water-cloud.lut',tmatrix_path='/network/group/aopp/eodg/shared/dubovik_tmatrix/',version=21"

export CREATE_ORAC_CLOUD_LUT_DRIVER="input_files/driver/terra_modis_cloud.driver"
echo "making ..." $CREATE_ORAC_LUT_DRIVER
idl -e "create_orac_cloud_lut_wrapper,srf_quad=1,mmfile='liquid-water_240.mm',lutfile='liquid-water-cloud.lut',tmatrix_path='/network/group/aopp/eodg/shared/dubovik_tmatrix/',version=21"

# water-ice section
export CREATE_ORAC_CLOUD_LUT_DRIVER="input_files/driver/terra_modis_cloud.driver"
echo "making ..." $CREATE_ORAC_LUT_DRIVER
idl -e "create_orac_cloud_lut_wrapper,srf_quad=1,mmfile='water-ice_agg.mm',lutfile='ice-cloud.lut',tmatrix_path='/network/group/aopp/eodg/shared/dubovik_tmatrix/',version=21"

