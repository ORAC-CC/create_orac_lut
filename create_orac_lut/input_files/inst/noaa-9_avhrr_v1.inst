# AVHRR instrument definition for ORAC code


# Format
# or * indicate a comment, can have blank lines. An = separates the constant and its value.

# constants
# + may be in any order
# + are case insensitive (will be translated to lower case)
# + may include spaces (they are ignored) 
# e.g. Solar Channels is equivalent to solarchannels

# uncertainty in albedo for solar channels and NedT for thermal and mixed thermal/solar channels

# quantities specific to a channel can be indicated using the nadir channelid (as a number) in []
platform = noaa-9
instrument = avhrr
instrument version = 2 (FM202)

# 0: single or N: dual view where N represents the channel offset of the slant view wrt the nadir view
view = 0

# specify instrument channels available as some instrument channels may be inapplicable, failed, too noisy etc
available channels  = 1 2 3 4 5

# specify which of the channels measure reflected solar radiation (includes channels around 4 um which have both a solar and emitted component)
solar channels  = 1 2 

# specify which of the channels measure emitted thermal radiation (includes channels around 4 um which have both a solar and emitted component)
thermal channels  =  3 4 5

# Figure below captures the maximum value (55.37) with a little tolerance 
maximum satellite zenith = 56

# spectral response functions
# taken from RTTOV spectral response function archive: https://www.nwpsaf.eu/site/software/rttov/download/coefficients/spectral-response-functions/
# channels follow ORAC (ie OSCAR) order except atsr, atsr-2 and aatsr which are reversed
 srf [1] = rtcoef_noaa_9_avhrr_srf_ch01.txt
 srf [2] = rtcoef_noaa_9_avhrr_srf_ch02.txt
 srf [3] = rtcoef_noaa_9_avhrr_srf_ch03.txt
 srf [4] = rtcoef_noaa_9_avhrr_srf_ch04.txt
 srf [5] = rtcoef_noaa_9_avhrr_srf_ch05.txt

# TEMPORARY 
# Old SAD values from  /network/aopp/apres/ORAC_LUTS/avhrr/NOAA6/
# carried through for back compatibility 
# REMOVE when new error calculation implemented
# F1 is multiple of F0 so calculated

oldf0[1] = 20.933 21.046
oldf0[2] = 22.993 23.003
oldf0[3] =  5.0467 5.0683

oldnefr[1] = 0.005
oldnefr[2] = 0.005
oldnefr[3] = 0

oldwvn[3] = 2691.65
oldwvn[4] =  929.433 
oldwvn[5] =  844.898

oldb1[3]  = 232270.29
oldb1[4]  =   9562.9182
oldb1[5]  =   7183.7104 

oldb2[3]  = 3872.8411
oldb2[4]  = 1337.2993 
oldb2[5]  = 1215.6673

oldt1[3]  =  1.914538
oldt1[4]  =  0.34229823 
oldt1[5]  =  0.23129257

oldt2[3]  =   0.99744947
oldt2[4]  =   0.99882228 
oldt2[5]  =   0.99913066 

oldnebt[3] = 0.25 
oldnebt[4] = 0.2 
oldnebt[5] = 0.2 

# channel random noise in percentage for solar channels and NEdT (K) for the thermal channels
# currently fill values of 0
 rua[1] =0
 rua[2] =0

 rub[1] =0
 rub[2] =0

 ruc[1] =0
 ruc[2] =0

 refbt  [3] = 0
 refbt  [4] = 0
 refbt  [5] = 0
 
 nedt   [3] = 0
 nedt   [4] = 0
 nedt   [5] = 0