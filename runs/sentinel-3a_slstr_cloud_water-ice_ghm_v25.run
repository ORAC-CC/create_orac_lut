; Sentinel-3A SLSTR V25 cloud LUT production run: water-ice_ghm, ice Grid B.
; One of the 20 definitive dual-view SLSTR V25 reference runs (Sentinel-3A;
; six liquid-water and four ice microphysical models). Submit the whole set
; with scripts/submit_v25_cloud_luts.sh.
;
; Settings follow the legacy sentinel-3a_slstr_cloud.driver (atmosphere 2,
; channels 1-9, no gas). The product is written directly to the flat
; permanent ORAC LUT directory as
;   sentinel-3a_slstr_m_water-ice_a01_pghm_v25.nc
;
; V25 = the V24 products (Grid B grids and numerics unchanged) computed with the
; adiabatic cloud temperature profile of create_orac_luts.py, "Versions and
; numerical changes" 5 (runs/V25_PRODUCTION.md): the cloud top stays at 240 K
; and the temperature rises downward along the saturated adiabat of the substance.
; nmom = 1000: the Baum (tabulated) path is unchanged from V23.

platform      = 'sentinel-3a'
instrument    = 'slstr'
forward_model = 'cloud'

in_path       = 'create_orac_lut/input_files'
instfile      = 'sentinel-3a_slstr_v1.inst'
mmfile        = 'water-ice_ghm.mm'
lutfile       = 'ice-cloud-grid-b.lut'

atmospheres   = 2
channelid     = [1, 2, 3, 4, 5, 6, 7, 8, 9]

gas           = 0
no_rayleigh   = 0
srf_quad      = 1
nstreams      = 60
nmom          = 1000
version       = 25
cloud_temperature_profile = 'adiabatic'

out_path      = '/network/group/aopp/eodg/RGG004_GRAINGER_ORACFILE/ORAC_LUTS'

