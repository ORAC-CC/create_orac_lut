; Sentinel-3A SLSTR V25 cloud LUT production run: liquid-water_273, liquid-water Grid B.
; One of the 20 definitive dual-view SLSTR V25 reference runs (Sentinel-3A;
; six liquid-water and four ice microphysical models). Submit the whole set
; with scripts/submit_v25_cloud_luts.sh.
;
; Settings follow the legacy sentinel-3a_slstr_cloud.driver (atmosphere 2,
; channels 1-9, no gas). The product is written directly to the flat
; permanent ORAC LUT directory as
;   sentinel-3a_slstr_m_liquid-water_a01_p273_v25.nc
;
; V25 = the V24 products (Grid B grids and numerics unchanged).  No liquid-water
; vertical cloud profile has been supplied, so this liquid-water LUT keeps the
; legacy isothermal thermal emission (cloud_vertical_profile = 'isothermal');
; see runs/V25_PRODUCTION.md.
; nmom is not set (obsolete for Mie classes): the expansion length comes from
; each size-averaged phase function.

platform      = 'sentinel-3a'
instrument    = 'slstr'
forward_model = 'cloud'

in_path       = 'create_orac_lut/input_files'
instfile      = 'sentinel-3a_slstr_v1.inst'
mmfile        = 'liquid-water_273.mm'
lutfile       = 'liquid-water-cloud-grid-b.lut'

atmospheres   = 2
channelid     = [1, 2, 3, 4, 5, 6, 7, 8, 9]

gas           = 0
no_rayleigh   = 0
srf_quad      = 1
nstreams      = 60
version       = 25
cloud_vertical_profile = 'isothermal'

out_path      = '/network/group/aopp/eodg/RGG004_GRAINGER_ORACFILE/ORAC_LUTS'

