; Sentinel-3B SLSTR V25 cloud LUT production run: water-ice_src, ice Grid B.
; One of the 20 definitive dual-view SLSTR V25 reference runs (Sentinel-3B;
; six liquid-water and four ice microphysical models). Submit the whole set
; with scripts/submit_v25_cloud_luts.sh.
;
; Settings follow the legacy sentinel-3b_slstr_cloud.driver (atmosphere 2,
; channels 1-9, no gas). The product is written directly to the flat
; permanent ORAC LUT directory as
;   sentinel-3b_slstr_m_water-ice_a01_psrc_v25.nc
;
; V25 = the V24 products (Grid B grids and numerics unchanged) computed with the
; supplied vertically inhomogeneous cirrostratus cloud profile of P. Watts (OCA /
; EUMETSAT) in the thermal emission, create_orac_luts.py "Versions and numerical
; changes" 5 (runs/V25_PRODUCTION.md): a 240 K cloud top with the supplied
; optical-depth and temperature-departure profiles below it.
; nmom = 1000: the Baum (tabulated) path is unchanged from V23.

platform      = 'sentinel-3b'
instrument    = 'slstr'
forward_model = 'cloud'

in_path       = 'create_orac_lut/input_files'
instfile      = 'sentinel-3b_slstr_v1.inst'
mmfile        = 'water-ice_src.mm'
lutfile       = 'ice-cloud-grid-b.lut'

atmospheres   = 2
channelid     = [1, 2, 3, 4, 5, 6, 7, 8, 9]

gas           = 0
no_rayleigh   = 0
srf_quad      = 1
nstreams      = 60
nmom          = 1000
version       = 25
cloud_vertical_profile = 'cirrostratus'

out_path      = '/network/group/aopp/eodg/RGG004_GRAINGER_ORACFILE/ORAC_LUTS'

