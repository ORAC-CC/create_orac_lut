; ORAC LUT Python-generator run-file template.
; Copy this file, edit the settings below, and pass the copy to
; create_orac_luts.py or ./submit.

platform      = 'meteosat-10'
instrument    = 'seviri'
forward_model = 'cloud'

in_path       = 'create_orac_lut/input_files'
instfile      = 'meteosat-10_seviri_v1.inst'
mmfile        = 'liquid-water_stg.mm'
lutfile       = 'liquid-water-cloud.lut'

atmospheres   = 2
channelid     = [1]

gas           = 0
no_rayleigh   = 0
srf_quad      = 1
nstreams      = 60
; Legendre expansion: the number of moments of a Mie phase function is
; determined from each size-distribution-averaged phase function (King's
; criterion, Grainger 1990), so nmom is not set.  nmom is required only for
; Baum / T-matrix (tabulated) microphysics, e.g.
;   nmom          = 1000

; Cloud temperature profile of the thermal-emission calculation (cloud forward
; model only): absent or 'isothermal' = the legacy isothermal cloud (up to V24);
; 'adiabatic' = V25, a 240 K cloud top with the saturated adiabat below it
; (create_orac_luts.py, "Versions and numerical changes" 5).
;   cloud_temperature_profile = 'adiabatic'

version       = 22
out_path      = 'luts'
