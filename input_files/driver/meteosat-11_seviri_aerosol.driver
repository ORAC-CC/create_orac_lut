# Non-optional arguments:
input_files                 # root input file path
meteosat-11_seviri_v1.inst       # instrument definition file
default.mm         # microphysical model file 
default.lut        # LUT definition file
#   0  = 'Midlatitude Summer (old version)'
#   1  = 'Tropical Atmosphere'
#   2  = 'Midlatitude Summer'
#   3  = 'Midlatitude Winter'
#   4  = 'Subarctic Summer'
#   5  = 'Subarctic Winter'
#   6  = '1976 US Standard'
2                        # atmospheric gas model based on MODTRAN codes
# Optional keyword parameters below:
channelid= [1, 2, 3 ]
gas=1
