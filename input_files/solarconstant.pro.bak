
  rttovfilterdir='/network/home/g/grainger/project-oraclut/create_orac_lut/input_files/srf'
  spawn,'ls -1 '+rttovfilterdir, rttov_filters

  q=where(strmid(rttov_filters,0,2) eq 'rt',count) ; select the filterfiles
  solar_spectrum_filename = ['sun/Thekaekara1973.sssi', 'sun/2000ASTM.sssi',   'sun/MCebKur.sssi',	  'sun/MChKur.sssi',	    'sun/MODWherli_WMO.sssi',		  'sun/MthKur.sssi', 'sun/MoldKur.sssi', 'sun/MNewKur.sssi','sun/Gueymard2018.sssi']

  
  variation = .0328
 

 
  fst = [284,300]

  centre=fltarr(7)
  F0=fltarr(7)
  Form='(A20,7(1x,F8.2))'
  
  For I = 0,1 do begin
    print,'Himawari-',8+I
    For J = 0,6 do begin
      srf= rttovfilterdir+'/'+rttov_filters[q[fst[i]]+j]
      read_srfstr,srf,srfstr
      centre[j]=srfstr.wvl_centre
      EndFor
      print, 'Channel:',centre,Format=  Form
      For K = 0,n_elements(solar_spectrum_filename)-1 do begin 
      load_solar_spectrum,solar_spectrum_filename[K],sssi
      For J = 0,6 do begin
        srf= rttovfilterdir+'/'+rttov_filters[q[fst[i]]+j]
        read_srfstr,srf,srfstr
        F0[J]=(simpson(srfstr.wvl,interpol(sssi.val*10,sssi.wvl, srfstr.wvl) *srfstr.srf)/  simpson(srfstr.wvl,srfstr.srf))/!pi
        If srfstr.wvl_centre gt 3  then begin
;         Calcuate solar constant for channel (only matters for joint ir/solar channels)  
          wvn=1d4/sssi.wvl
		  print,F0[J]
          F0[J] =  (simpson(srfstr.wvn,interpol(1d8*sssi.val/wvn^2,wvn, srfstr.wvn) *srfstr.srf)/  simpson(srfstr.wvn,srfstr.srf))/!pi
        endif  
      Endfor
      print,sssi.name,f0,Format=  Form
    endfor
  Endfor
end