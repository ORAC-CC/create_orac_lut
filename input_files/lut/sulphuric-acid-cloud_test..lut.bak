# This file defines the fast LUT tables for sulphuric acid Cloud
2 linear # 20 Optical depth values, to be output as log(OpD)
  5.0000E-01 10 
2 linear # 20 Effective radius values, to be output as log(EfR)
1 10
2 linear # 10 Satellite zenith angles
0 90
2 linear # 10 Solar zenith angles
0 90
2 linear # 11 Relative azimuth angles
0 180