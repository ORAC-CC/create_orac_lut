oldf0[1] = 18.25
oldf0[2] = 18.25
oldf0[3] = 18.25
oldf0[4] =  5.39

oldnefr[1] = 0.005
oldnefr[2] = 0.005
oldnefr[3] = 0.005
oldnefr[4] = 0.0

oldwvn[4] = 2664.02
oldwvn[5] = 925.792
oldwvn[6] = 829.708

oldb1[4]  = 226709.42
oldb1[5]  = 9546.4671
oldb1[6]  = 6857.2371

oldb2[4]  = 3841.6841
oldb2[5]  = 1336.532
oldb2[6]  = 1196.9652

oldt1[4]  = 1.67396
