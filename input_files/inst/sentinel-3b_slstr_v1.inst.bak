# SLSTR on sentinel-3b instrument definition for ORAC code

# Format
# or * indicate a comment, can have blank lines. An = separates the constant and its value.

# For ease a number is used to refer to a channel rather than the channelid, ie the two digit string that labels a channel
# ie in this file only 1 represents '01', 2 '02 and so on

# constants
# + may be in any order
# + are case insensitive (will be translated to lower case)
# + may include spaces (they are ignored) 
# e.g. Solar Channels is equivalent to solarchannels

# uncertainty in albedo for solar channels and NedT for thermal and mixed thermal/solar channels

# quantities specific to a channel can be indicated using the channelid (as a number) in []

platform = sentinel-3b
instrument = SLSTR
instrument version = unknown

# 0: single or N: dual view where N represents the channel offset of the slant view wrt the nadir view
view = 9

# specify instrument channels used as some instrument channels may be inapplicable, failed, too noisy etc
available channels = 1 2 3 4 5 6 7 8 9

# specify which of the channels measure reflected solar radiation (includes channels around 4 um which have both a solar and emitted component)
solar channels  = 1 2 3 4 5 6 7

# specify which of the channels measure emitted thermal radiation (includes channels around 4 um which have both a solar and emitted component)
thermal channels  = 7 8 9

# Figure below captures the maximum value (55) https://www.tandfonline.com/doi/full/10.1080/09500340.2010.503010?scroll=top&needAccess=true
# some pixels give an angle of 55.1!
maximum satellite zenith = 56

# spectral response functions
# taken from RTTOV spectral response function archive: https://www.nwpsaf.eu/site/software/rttov/download/coefficients/spectral-response-functions/
# channels follow ORAC (ie OSCAR) order except atsr, atsr-2 and aatsr which are reversed
 srf [1] = rtcoef_sentinel3_2_slstr_srf_ch01.txt
 srf [2] = rtcoef_sentinel3_2_slstr_srf_ch02.txt
 srf [3] = rtcoef_sentinel3_2_slstr_srf_ch03.txt
 srf [4] = rtcoef_sentinel3_2_slstr_srf_ch04.txt
 srf [5] = rtcoef_sentinel3_2_slstr_srf_ch05.txt
 srf [6] = rtcoef_sentinel3_2_slstr_srf_ch06.txt
 srf [7] = rtcoef_sentinel3_2_slstr_srf_ch07.txt
 srf [8] = rtcoef_sentinel3_2_slstr_srf_ch08.txt
 srf [9] = rtcoef_sentinel3_2_slstr_srf_ch09.txt



