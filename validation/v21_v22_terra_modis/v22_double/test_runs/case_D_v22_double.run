; Compact launcher test of the double-precision V22 release (case D: Terra MODIS p240 ch1, tau 4/8/16, re 9/11/13, SZA 40).
platform      = 'terra'
instrument    = 'modis'
forward_model = 'cloud'

in_path       = 'validation/v21_v22_terra_modis/v22_double/work/case_D/input_files'
instfile      = 'terra_modis_v1.inst'
mmfile        = 'liquid-water_240.mm'
lutfile       = 'case_D.lut'

atmospheres   = 2
channelid     = [1]

gas           = 0
no_rayleigh   = 0
srf_quad      = 1
nstreams      = 60
nmom          = 1000
version       = 22

out_path      = 'validation/v21_v22_terra_modis/v22_double/launcher_test'
