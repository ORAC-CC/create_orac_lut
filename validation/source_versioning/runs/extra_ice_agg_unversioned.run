; V01 source-set check: compact Baum ice (water-ice agg) case (unversioned run).
platform      = 'meteosat-10'
instrument    = 'seviri'
forward_model = 'cloud'
in_path       = 'create_orac_lut/input_files'
instfile      = 'meteosat-10_seviri_v1.inst'
mmfile        = 'water-ice_agg.mm'
lutfile       = 'ice-cloud_test.lut'
atmospheres   = 2
channelid     = [1, 9]
gas           = 0
no_rayleigh   = 0
srf_quad      = 1
reuse_scat    = 0
scat_only     = 0
nstreams      = 60
nmom          = 1000
version       = 22
out_path      = 'validation/tmp/source_versioning/compact/unversioned/extra_ice_agg'
