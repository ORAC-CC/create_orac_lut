# Compact liquid-water grid for the V23/V24 scattering-refinement comparison
# (validation/v24/scattering_refinements/compact_lut.py).  Not a production
# grid: every value is a node of the approved Grid B liquid-water-cloud.lut.
5 uneven_logarithmic # optical depth
0.125 1.0 8.0 64.0 256.0
5 uneven_linear # physical effective radius, microns
1.0 5.0 11.0 21.0 39.0
4 uneven_linear # solar zenith, degrees
0.0 30.0 60.0 75.0
4 uneven_linear # satellite zenith, degrees
0.0 30.0 60.0 75.0
7 linear # relative azimuth, degrees, 0-180
0 180
