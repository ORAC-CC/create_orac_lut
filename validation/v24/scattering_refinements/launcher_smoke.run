; Launcher smoke test of LUT release V24 (validation only): the V24 run file of
; liquid-water_240 with the compact Grid B subset and channels 1 and 31,
; through create_orac_luts_release_v04.py with releases/lut_v24.release.

platform      = 'terra'
instrument    = 'modis'
forward_model = 'cloud'

in_path       = 'create_orac_lut/input_files'
instfile      = 'terra_modis_v1.inst'
mmfile        = 'liquid-water_240.mm'
lutfile       = '/home/g/grainger/project-oraclut/validation/v24/scattering_refinements/compact_liquid_grid_b.lut'

atmospheres   = 2
channelid     = [1, 31]

gas           = 0
no_rayleigh   = 0
srf_quad      = 1
nstreams      = 60
nmom          = 1000
version       = 24

out_path      = 'validation/v24/scattering_refinements/work/launcher_smoke'
