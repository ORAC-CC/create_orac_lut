; Launcher smoke test of LUT release V25 (validation/v25/REPORT_v25_temperature_profiles.md):
; the V25 pagg run file with the compact ice grid, channels 1, 6, 7, 20, 31, 32, written to validation/.
;   ORAC_LUT_RELEASE_MANIFEST=lut_v25.release ORAC_LUT_DISORT_PRECISION=single ORAC_LUT_DISORT_SP_KERNEL=intel_dlm \
;   python create_orac_luts_release_v04.py validation/v25/temperature_profiles/launcher_smoke.run
; The product must equal the working-tree compact profile run (work/r2_water-ice_agg_profile) in every variable.
platform      = 'terra'
instrument    = 'modis'
forward_model = 'cloud'
in_path       = 'create_orac_lut/input_files'
instfile      = 'terra_modis_v1.inst'
mmfile        = 'water-ice_agg.mm'
lutfile       = '/home/g/grainger/project-oraclut/validation/v25/temperature_profiles/compact_ice_grid_b.lut'
atmospheres   = 2
channelid     = [1, 6, 7, 20, 31, 32]
gas           = 0
no_rayleigh   = 0
srf_quad      = 1
nstreams      = 60
nmom          = 1000
version       = 25
out_path      = 'validation/v25/temperature_profiles/work/launcher_smoke'
cloud_vertical_profile = 'cirrostratus'
